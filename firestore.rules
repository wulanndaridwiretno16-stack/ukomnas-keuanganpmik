rules_version = '2';
// UKOMNAS PMIK - Keuangan TUK
// Peran: admin | pj (PJ Keuangan) | pp (Pengawas Pusat)
service cloud.firestore {
  match /databases/{database}/documents {

    // Email yang berhak menjadi admin (harus terverifikasi). Ubah bila perlu.
    function adminEmail() {
      return request.auth.token.email == 'wulanndari.dwiretno16@gmail.com'
          && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    function mePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myRole() { return exists(mePath()) ? get(mePath()).data.role : 'none'; }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function isKampus() { return signedIn() && myRole() == 'kampus'; }
    function isPJ()    { return signedIn() && (myRole() == 'pj' || myRole() == 'admin'); }

    match /users/{uid} {
      allow get, list: if signedIn() && (
        uid == request.auth.uid
        || isAdmin()
        || resource.data.pj_id == request.auth.uid
        // PJ mencari PP yang belum punya PJ (query harus memuat role=='pp' & pj_id==null)
        || (isPJ() && resource.data.role == 'pp' && resource.data.pj_id == null));

      // Pendaftaran: selalu sebagai PP. pj_id boleh terisi hanya jika sesuai kode PJ.
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.role in ['pp','kampus']
        && (request.resource.data.role == 'pp' || request.resource.data.pj_id == null)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.pj_id == null
            // PP yang emailnya sudah diunggah PJ (koleksi roster) otomatis terhubung ke PJ tersebut
            || (exists(/databases/$(database)/documents/roster/$(request.auth.token.email.lower()))
                && get(/databases/$(database)/documents/roster/$(request.auth.token.email.lower())).data.pj_id
                   == request.resource.data.pj_id)
            || (request.resource.data.kode_used is string
                && exists(/databases/$(database)/documents/pjCodes/$(request.resource.data.kode_used))
                && get(/databases/$(database)/documents/pjCodes/$(request.resource.data.kode_used)).data.pj_id
                   == request.resource.data.pj_id));

      allow update: if signedIn() && (
        isAdmin()
        // ubah profil sendiri
        || (uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name','institusi']))
        // pemilik email admin (terverifikasi) menjadikan dirinya admin
        || (uid == request.auth.uid && adminEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','kode_pj'])
            && request.resource.data.role == 'admin')
        // PJ mengampu PP yang belum punya PJ
        || (isPJ() && resource.data.role == 'pp' && resource.data.pj_id == null
            && request.resource.data.pj_id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pj_id']))
        // PJ melepas PP miliknya
        || (isPJ() && resource.data.role == 'pp' && resource.data.pj_id == request.auth.uid
            && request.resource.data.pj_id == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pj_id']))
      );
      allow delete: if false;
    }

    // Kode PJ -> id PJ (dipakai saat PP mendaftar). Hanya dibaca per-dokumen.
    match /pjCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Daftar PP yang diunggah PJ (id dokumen = email huruf kecil)
    match /roster/{em} {
      allow get: if signedIn() && (em == request.auth.token.email.lower()
                    || isAdmin() || (isPJ() && resource.data.pj_id == request.auth.uid));
      allow list: if isAdmin() || (isPJ() && resource.data.pj_id == request.auth.uid);
      allow create, update: if isPJ() && (request.resource.data.pj_id == request.auth.uid || isAdmin())
                              && request.resource.data.email.lower() == em;
      allow delete: if isPJ() && (resource.data.pj_id == request.auth.uid || isAdmin());
    }

    match /reports/{id} {
      function ppBelongsToPj(d) {
        return exists(/databases/$(database)/documents/users/$(d.pp_id))
          && get(/databases/$(database)/documents/users/$(d.pp_id)).data.role == 'pp'
          && get(/databases/$(database)/documents/users/$(d.pp_id)).data.pj_id == d.pj_id;
      }
      // Jumlah nama yang diisi PP tidak boleh melebihi jumlah petugas buatan PJ (jumlah_petugas).
      function capOk(d, old, k) {
        return !(k in d.petugas) || !('jumlah_petugas' in old) || !(k in old.jumlah_petugas)
          || (d.petugas[k] is list && d.petugas[k].size() <= old.jumlah_petugas[k]);
      }
      function valid(d) {
        return d.status in ['draft','published']
          && d.tuk_name is string && d.items is list && d.total is number
          && (d.status == 'draft' || (d.tuk_name.size() > 0 && d.total > 0));
      }

      allow get, list: if signedIn() && (
        resource.data.pj_id == request.auth.uid
        || isAdmin()
        || (resource.data.pp_id == request.auth.uid && resource.data.status == 'published'));

      allow create: if isPJ() && valid(request.resource.data)
        && (request.resource.data.pj_id == request.auth.uid || isAdmin())
        && ppBelongsToPj(request.resource.data);

      allow update: if isPJ() && (resource.data.pj_id == request.auth.uid || isAdmin())
        && valid(request.resource.data)
        && request.resource.data.pj_id == resource.data.pj_id
        && ppBelongsToPj(request.resource.data);

      // PP hanya boleh mengisi nama petugas/rumah makan dan realisasi pelaksanaan pada laporan miliknya
      // yang sudah terbit. Semua field buatan PJ (anggaran/biaya, TUK, tahun, dst) tidak dapat diubah PP.
      allow update: if signedIn() && resource.data.pp_id == request.auth.uid
        && resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['petugas','realisasi','pp_mandiri','petugas_at'])
        && (!('petugas' in request.resource.data) || (request.resource.data.petugas is map
            && capOk(request.resource.data, resource.data, 'pl') && capOk(request.resource.data, resource.data, 'admin')
            && capOk(request.resource.data, resource.data, 'it_lokal') && capOk(request.resource.data, resource.data, 'co_cbt')))
        && (!('realisasi' in request.resource.data) || request.resource.data.realisasi is map)
        && (!('pp_mandiri' in request.resource.data) || request.resource.data.pp_mandiri is map);

      allow delete: if isPJ() && (resource.data.pj_id == request.auth.uid || isAdmin());
    }

    // ===== Pendaftaran UKOMNAS oleh kampus: pengaturan, nomor berurutan, pendaftaran/invoice, bukti bayar =====
    match /config/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isAdmin();
    }
    // penghitung nomor invoice/kuitansi: hanya boleh naik tepat 1
    match /counters/{id} {
      allow get: if signedIn();
      allow create: if (isKampus() || isAdmin()) && request.resource.data.n == 1;
      allow update: if (isKampus() || isAdmin()) && request.resource.data.n == resource.data.n + 1;
    }
    match /pendaftaran/{id} {
      allow get, list: if signedIn() && (resource.data.kampus_id == request.auth.uid || isAdmin());
      // kampus: tarif harus sama dengan tarif yang ditetapkan Admin; total = tarif x jumlah peserta
      allow create: if isAdmin() || (isKampus()
        && request.resource.data.kampus_id == request.auth.uid
        && request.resource.data.status == 'menunggu_pembayaran'
        && request.resource.data.jumlah_peserta is int && request.resource.data.jumlah_peserta > 0
        && request.resource.data.tarif == get(/databases/$(database)/documents/config/pendaftaran).data.tarif
        && request.resource.data.total == request.resource.data.tarif * request.resource.data.jumlah_peserta);
      allow update: if isAdmin() || (signedIn() && resource.data.kampus_id == request.auth.uid && (
        // 1) ubah data/jumlah peserta selama belum bayar (tarif tidak boleh berubah)
        (resource.data.status == 'menunggu_pembayaran'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jumlah_peserta','total','kontak_nama','kontak_hp','kontak_email','alamat','kota','catatan','updated_at'])
          && request.resource.data.jumlah_peserta is int && request.resource.data.jumlah_peserta > 0
          && request.resource.data.total == resource.data.tarif * request.resource.data.jumlah_peserta)
        // 2) kirim bukti bayar -> menunggu verifikasi
        || (resource.data.status in ['menunggu_pembayaran','ditolak']
          && request.resource.data.status == 'menunggu_verifikasi'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','tgl_bayar','jumlah_dibayar','catatan_bayar','bukti_at','updated_at']))));
      allow delete: if isAdmin() || (signedIn() && resource.data.kampus_id == request.auth.uid && resource.data.status == 'menunggu_pembayaran');
    }
    // foto bukti transfer (dikompresi, disimpan sebagai teks); id dokumen = id pendaftaran
    match /bukti/{id} {
      allow get: if signedIn() && (resource.data.kampus_id == request.auth.uid || isAdmin());
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.kampus_id == request.auth.uid
        && get(/databases/$(database)/documents/pendaftaran/$(id)).data.kampus_id == request.auth.uid
        && get(/databases/$(database)/documents/pendaftaran/$(id)).data.status in ['menunggu_pembayaran','ditolak','menunggu_verifikasi']
        && request.resource.data.data is string && request.resource.data.data.size() < 700000;
      allow delete: if isAdmin();
    }
  }
}
